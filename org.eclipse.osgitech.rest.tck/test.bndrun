	org.eclipse.jetty.io;version='[12.0.32,12.0.33)',\
	org.eclipse.jetty.security;version='[12.0.32,12.0.33)',\
	org.eclipse.jetty.server;version='[12.0.32,12.0.33)',\
	org.eclipse.jetty.session;version='[12.0.32,12.0.33)',\
	org.eclipse.jetty.util;version='[12.0.32,12.0.33)',\
	org.eclipse.osgitech.rest;version='[2.0.0,2.0.1)',\
	org.eclipse.osgitech.rest.jetty;version='[2.0.0,2.0.1)',\
	org.eclipse.osgitech.rest.sse;version='[2.0.0,2.0.1)',\
